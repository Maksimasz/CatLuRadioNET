<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>CatLuRadio</AssemblyName>
    <RootNamespace>CatLuRadio</RootNamespace>
    <Version>3.5.8</Version>
    <AssemblyVersion>3.5.8.0</AssemblyVersion>
    <FileVersion>3.5.8.0</FileVersion>
    <!-- SDK дописывает хеш коммита к InformationalVersion (3.5.2+abcdef...).
         Из-за этого ломается Version.TryParse в CheckForUpdate — обновления
         перестают находиться — и хеш попадает в заголовок окна. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors></Authors>
    <Company>CatLu</Company>
    <Product>CatLu Radio NET</Product>
    <Description>Internet Radio Player</Description>
    <Copyright>ISC</Copyright>
    <!-- Оптимизации для уменьшения размера -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="LibVLCSharp" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!-- Пакет WebView2 безусловно подключает и свою WPF-сборку
       (build/Common.targets:131), хотя проект чисто WinForms. Она нигде не
       используется, но её WindowsBase конфликтует с WindowsBase из референсной
       сборки net8.0 — 22 строки предупреждения MSB3277 при каждой сборке.
       Статически ссылку не убрать: пакет подключает её после тела .csproj,
       поэтому убираем на этапе выполнения, до разрешения ссылок. -->
  <Target Name="ExcludeUnusedWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="WebView2Runtime\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
