# --- Артефакты сборки .NET ---
[Bb]in/
[Oo]bj/

# --- Релизы и установщик ---
release/
installer/downloads/
installer/dependencies/

# --- Сторонние бинарники, не наш код ---
# WebView2 Fixed Version Runtime (668 МБ) — скачивается отдельно,
# см. installer/downloads/*.cab. Не коммитим: это дистрибутив Microsoft.
WebView2Runtime/
# yt-dlp.exe (~17 МБ) — бинарник от старых сборок: приложению он больше
# не нужен, лежит только локально, в git и в установщик не попадает.
/yt-dlp.exe
# CatLuRadioNet.ico — черновая иконка, нигде не используется
# (ApplicationIcon и установщик работают с icon.ico), лежит только локально.
/CatLuRadioNet.ico

# --- Среда разработки ---
.vs/
*.user
*.suo
*.DotSettings.user

# --- Локальное ---
*.log
Thumbs.db
Desktop.ini
# --- Отчёты инструментов (генерируются локально) ---
tools/stations-report.json
